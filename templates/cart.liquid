<div id="cart-container" class="w-full flex flex-col items-center justify-center">
  <h1 class="hidden">cart</h1>
  <div class="image-container w-3/12 md:w-2/12 mt-4">
    <img
      src="https://cdn.shopify.com/s/files/1/0481/8013/4054/files/PurposeOvaEverything_Logo_WhiteStroke.svg?v=1602466982"
      alt="The Purpose Ova Everything Logo in White"

    />
  </div>

  <div class="w-full max-w-6xl mt-20 mx-3">
    {% if cart.item_count > 0 %}
      <form action="/cart" method="post" novalidate>
        <div>
          <div>
            {% for item in cart.items %}
              <div class="border-b-2 border-white hover:bg-gray mx-3">
                <div class="cart-item flex flex-col md:flex-row items-center justify-start m-3 pb-3">
                  <div class="flex flex-row md:flex-1 items-center border-dotted border-b-2 md:border-0 border-white w-full sm:mb-3 md:mb-0">
                    <a href="{{ item.url | within: collections.all }}">
                      <img src="{{ item | img_url: 'small' }}" alt="{{ item.title | escape }}" class="rounded-full object-cover h-16 w-16 m-3">
                    </a>
                    <a href="{{ item.url }}" class="text-2xl font-bold">{{ item.product.title }}</a>
                    {%if item.product.title == 'The Dad Hat' %}
                      <div class="variant variant-color inline-block ml-4">
                        {%if item.variant.title == 'Denim' %}
                          <span class="inline-flex items-center justify-center text-xl font-bold rounded-full border-white border-2 hover:border-green w-8 h-8 m-1" for="variant-{{item.variant.id}}" style="background-image: conic-gradient(from 180deg at 50% 50%, #133C6C 0deg, rgba(42, 111, 192, 0) 360deg);"></span>
                        {% else %}
                          <span class="inline-flex items-center justify-center text-xl font-bold rounded-full border-white border-2 bg-black hover:border-green w-8 h-8 m-1" for="variant-{{item.variant.id}}"></span>
                        {% endif %}
                      </div>
                    
                    {% else if item.product.title == 'Purpose Ova Everything Mask' %}
                       <span></span>
                    {% else %}
                      <div class="variant variant-size inline-block">
                        <input type="radio" class="hidden" name="id" id="variant-{{item.variant.id}}" value="{{item.variant.id}}" required />
                        <label class="inline-flex items-center justify-center text-xl font-bold rounded-full border-white border-2 text-white hover:bg-green w-8 h-8 m-1" for="variant-{{item.variant.id}}">{{ item.variant.title }}</label>
                      </div>
                    {% endif %}
                  </div>
                  <div class="flex flex-row md:flex-1 items-baseline justify-center border-dotted md:border-l-2 mt-3 md:mb-0 md:ml-3 md:pl-3">
                    <span class="text-center inline-block mr-2">{{ item.price | money }} <span>x</span></span>
                    <div class="text-center">
                      <input type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0" class="inline-block border-2 border-white rounded-md p-2 w-12 md:w-auto bg-black">
                    </div>
                    <span class="inline-block ml-2">:</span>
                    <span class="text-center text-xl font-bold">
                      {% if item.original_line_price != item.line_price %}{{ item.original_line_price | money }}{% endif %}
                      {{ item.line_price | money }}
                      {% for discount in item.discounts %}{{ discount.title }}{% endfor %}
                    </span>
                    <a href="/cart/change?line={{ forloop.index }}&amp;quantity=0" class="bg-red p-2 rounded-md m-1 ml-4">remove</a>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>

        <div class="flex flex-col items-center mb-20">
          <p class="text-2xl md:text-xl my-5">Subtotal: <strong>{{ cart.total_price | money }}</strong></p>
          <div class="flex flex-col md:flex-row items-center justify-center w-11/12">
            <button type="submit" name="update" class="border-4 border-blue rounded-lg text-xl text-blue hover:text-white hover:bg-blue text-semibold py-5 px-12 mx-0 mb-1 md:m-5 w-full md:w-auto">Update</button>
            <button type="submit" name="checkout" class="border-4 border-green rounded-lg text-xl text-green hover:text-white hover:bg-green text-semibold py-5 px-12 mx-0 mt-1 md:m-5 w-full md:w-auto">Checkout</button>
          </div>
        </div>
      </form>

    {% else %}
      <div class="flex flex-col items-center">
        <h2 class="text-center text-5xl font-semibold">The Cart is empty 🙁.</h2>
        <h3 class="text-center text-3xl">Take a look at the <a href="/products/classic-shirt" class="underline">Classic Shirt</a> and <a href="/products/dad-hat" class="underline">Dad Hat</a>!</h3>
      </div>
    {% endif %}
  </div>
</div>