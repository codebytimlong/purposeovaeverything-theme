<!-- logo is position absolute -->
<div class="w-full h-screen">
  <div class="w-full h-full relative flex justify-center items-center">
    <div class="image-container fixed z-50 w-full h-full flex flex-col justify-center items-center">
      <img
        src="{{ 'logo.svg' | asset_url }}"
        alt="The Purpose Ova Everything Logo in White"
        class="fade-in min-w-320 max-w-2xl w-1/3 p-5 opacity-0 pointer-events-none"
      />
      
      
      <div class="flex flex-col justify-center items-center my-5 rounder-md bg-black border-4 border-white pb-4">
        <h5 class="text-xs uppercase italic text-center border-b-2 border-white p-2 w-full">New Shirt Colors!</h5>
        <p class="text-xl md:text-2xl text-center px-8 py-2">
          Check out the new colors <br> available now in our catalog.
        </p>
        <a href="/collections/all" class="fade-in text-xl md:text-2xl text-center text-green underline w-full opacity-0">View the Catalog</a>
      </div>
    </div>

    <div class="w-full h-full">
      <video 
        id="bgVideo" 
        class="w-full h-full object-cover" 
        autoplay loop muted playsinline 
      >
          <source 
            src="https://cdn.shopify.com/s/files/1/0457/9790/0454/files/poe_video_handbrake.mp4?v=1630162485"
            type="video/mp4" />
          <source 
            src="https://cdn.shopify.com/s/files/1/0457/9790/0454/files/poe_video.webm?v=1629593310"
            type="video/webm" />
      </video>
    </div>    
  </div>
</div>

<script>
  
  // New Shirt Video BG AutoPlay
  document.addEventListener('DOMContentLoaded', function() {
    const bgVideo = document.getElementById("bgVideo");
    bgVideo.addEventListener('canplaythrough',function(event){
      console.log(event);
      event.target.play();
    });
  });

  // Add Fade-ins -----
  document.addEventListener( 'DOMContentLoaded', (event) => {
    anime({
      targets: '.fade-in',
      opacity: '1',
      easing: 'easeInOutQuad',
      delay: anime.stagger(600)
    });
  } )
</script>