{% comment %}
  Privacy Policy page template.

  Renders the privacy policy from Shopify admin -> Settings -> Policies ->
  Privacy policy, so it is edited in one place and stays in sync with
  Shopify's built-in /policies/ page and checkout links.

  How to use:
  1. Fill in the policy under Settings -> Policies -> Privacy policy.
  2. Online Store -> Pages -> Add page, title it "Privacy Policy", and under
     Theme template choose `privacy-policy`. Leave the page body empty.

  If the policy in Settings is empty, the page body is shown instead.
{% endcomment %}

{%- assign policy = shop.privacy_policy -%}

<div class="w-full flex justify-center">
  <div class="w-full max-w-3xl px-6 pt-40 pb-24 md:px-8">
    <h1 class="text-4xl md:text-5xl font-semibold border-b-4 border-white pb-4 mb-10">
      {{ page.title | default: policy.title | default: 'Privacy Policy' }}
    </h1>

    <div class="rich-text text-lg leading-relaxed">
      {% if policy.body != blank %}
        {{ policy.body }}
      {% elsif page.content != blank %}
        {{ page.content }}
      {% else %}
        <p class="italic opacity-75">
          No privacy policy yet. Add it in Shopify admin under
          Settings &rarr; Policies &rarr; Privacy policy.
        </p>
      {% endif %}
    </div>
  </div>
</div>

{% render 'rich-text-styles' %}
