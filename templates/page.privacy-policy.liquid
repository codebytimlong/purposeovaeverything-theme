{% comment %}
  Privacy Policy page template.

  How to use:
  1. Shopify admin -> Online Store -> Pages -> Add page.
  2. Title it "Privacy Policy" and, under Theme template, choose
     `privacy-policy`. (Shopify does not pick templates by handle; the
     template has to be selected on the page.)
  3. Paste your policy text into the page body, then Save.
     Whatever you paste renders inside the styled area below.

  This template is content-driven, so the policy can be updated from the
  admin at any time without changing any code.
{% endcomment %}

<div class="w-full flex justify-center">
  <div class="w-full max-w-3xl px-6 pt-40 pb-24 md:px-8">
    <h1 class="text-4xl md:text-5xl font-semibold border-b-4 border-white pb-4 mb-10">
      {{ page.title | default: 'Privacy Policy' }}
    </h1>

    <div class="rich-text text-lg leading-relaxed">
      {% if page.content != blank %}
        {{ page.content }}
      {% else %}
        <p class="italic opacity-75">
          This page is empty. Add your privacy policy content in Shopify admin
          under Online Store &rarr; Pages &rarr; Privacy Policy.
        </p>
      {% endif %}
    </div>
  </div>
</div>

{% render 'rich-text-styles' %}
